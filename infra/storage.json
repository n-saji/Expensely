{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Migrated Expensely storage and EC2 application access",
  "Resources": {
    "Expenses": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": "expensely-expenses-993371733162",
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedHeaders": [
                "*"
              ],
              "AllowedMethods": [
                "PUT",
                "POST",
                "GET"
              ],
              "AllowedOrigins": [
                "http://localhost:3000",
                "https://sit.expensely.store",
                "https://expensely.store"
              ],
              "ExposedHeaders": [
                "ETag"
              ],
              "MaxAge": 3000
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ArchiveReceipts",
              "Status": "Enabled",
              "Prefix": "",
              "Transitions": [
                {
                  "StorageClass": "GLACIER_IR",
                  "TransitionInDays": 30
                }
              ],
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        }
      }
    },
    "Profiles": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": "expensely-profiles-993371733162",
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": false,
          "RestrictPublicBuckets": false
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedHeaders": [
                "*"
              ],
              "AllowedMethods": [
                "PUT",
                "POST",
                "GET",
                "HEAD",
                "DELETE"
              ],
              "AllowedOrigins": [
                "http://localhost:3000",
                "https://sit.expensely.store",
                "https://expensely.store"
              ],
              "ExposedHeaders": [
                "ETag"
              ],
              "MaxAge": 3000
            }
          ]
        }
      }
    },
    "ProfileRead": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Profiles"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ExistingProfilePublicRead",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${Profiles.Arn}/*"
              }
            }
          ]
        }
      }
    },
    "AppStorageAccess": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ExpenselyMigratedStorage",
        "Roles": [
          "EC2DockerDeployRole"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
              ],
              "Resource": [
                {
                  "Fn::Sub": "${Expenses.Arn}/*"
                },
                {
                  "Fn::Sub": "${Profiles.Arn}/*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Expenses",
                    "Arn"
                  ]
                },
                {
                  "Fn::GetAtt": [
                    "Profiles",
                    "Arn"
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
